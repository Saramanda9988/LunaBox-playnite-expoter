<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="LOCLunaBoxExporterMenuItem">为 LunaBox 导出游戏库</sys:String>
    <sys:String x:Key="LOCLunaBoxExporterFileFilter">LunaBox ZIP|*.zip</sys:String>
    <sys:String x:Key="LOCLunaBoxExporterTitle">LunaBox 导出器</sys:String>
